---
// A docs paragraph's spans (src/lib/docs.js): bold, italic, `code` (a button or setting name) and links.
interface Props { spans: any[]; local?: Record<string, string> }
const { spans, local } = Astro.props;
const href = (s) => s.href ?? `${local?.[s.page] ?? `/docs/${s.page}/`}${s.anchor ? `#${s.anchor}` : ''}`;
const inner = (s) => {
  let html = s.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
  if (s.code) html = `<code class="d-code">${html}</code>`;
  if (s.i) html = `<em>${html}</em>`;
  if (s.b) html = `<strong>${html}</strong>`;
  return html;
};
---
{spans.map((s) =>
  s.href || s.page
    ? <a href={href(s)} class="d-link" rel={s.href ? 'noopener' : undefined} set:html={inner(s)} />
    : <Fragment set:html={inner(s)} />
)}
