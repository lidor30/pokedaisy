---
// The AYN Thor at its real proportions (halves 150 x 94 mm: scripts/handheld-art.mjs draws it, a little pixelated, into
// public/media/handheld-thor.png) on a grid of handheld units (--u, 160 across: handheldFit.js). The lid: the 6" 16:9 top screen under glass, thin bezels all round.
// The hinge. The base: the 3.92" bottom screen (1240x1080, the companion's canvas) between the controls - the
// left stick in its light ring over the d-pad, ABXY over the right stick - the small keys under it and the
// speaker grilles. The screens are HTML over the drawing: the top one is HeroScene's overworld, the bottom one
// plays the companion's PARTY, MAP and BAG tabs (CompanionDemo). A page can put its own pictures on either screen
// instead (`slot="top"` / `slot="bottom"`: the homepage's and the game pages' real shots).
import CompanionDemo from './CompanionDemo.astro';
import HeroScene from './HeroScene.astro';

interface Props { still?: boolean }
const { still = false } = Astro.props;
const at = (x: number, y: number, w?: number, h?: number) => `--x:${x};--y:${y}` + (w ? `;--w:${w};--h:${h}` : '');
import { trFor } from '../i18n/index.js';

const tr = trFor(Astro.url);
---
<div class="hh-box">
  <div class:list={['handheld', 'thor', still && 'still']} data-handheld data-units="160">
    <img class="hh-art" src="/media/handheld-thor.png" width="240" height="309" alt="" aria-hidden="true" decoding="async" />
    <div class="hh-part topscreen" style={at(9.15, 10.15, 141.7, 79.7)}>
      <slot name="top"><HeroScene lines={[tr('Your party is on the bottom screen.'), tr('So are the map, the bag and your dex.'), tr('In a battle, every matchup is a glance away.')]} /></slot>
    </div>
    <div class="hh-part lowscreen" style={at(40, 114, 80, 69.8)}><slot name="bottom"><CompanionDemo /></slot></div>
  </div>
</div>

<style is:global>
  /* Shared by both hero handhelds: their box (for the unit's fallback before the script measures it), the unit
     the drawing and the screens are placed in, and every part placed in units. */
  .hh-box { container-type: inline-size; }
  .handheld { --u: calc(100cqw / var(--units, 160)); --px: var(--u); position: relative; margin: 0 auto; font-family: 'Pixel Operator', monospace; }
  .handheld .hh-part { position: absolute; left: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); }
  .handheld .hh-part[style*='--w'] { width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); }
  /* The drawing: a small PNG scaled up with hard edges (its pixels are part of the look). */
  .handheld .hh-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; image-rendering: pixelated; pointer-events: none; user-select: none; }
  .handheld .pixel { display: block; }
  .handheld .appcard { filter: none; }
  .handheld .appwrap { max-width: none; }
  .handheld .topscreen, .handheld .lowscreen { overflow: hidden; background: #000; border-radius: calc(var(--u) * 0.6); }
  .handheld.still * { animation: none !important; transition: none !important; }

  .thor { --units: 160; width: calc(var(--u) * 160); height: calc(var(--u) * 206);
    filter: drop-shadow(0 calc(var(--u) * 3) calc(var(--u) * 4) rgba(29, 27, 38, 0.28)); }
</style>

<script>
  import { fitHandhelds } from '../lib/handheldFit.js';
  fitHandhelds();
</script>
