---
// The ROM check: reads a dropped ROM in the browser (never uploaded) and judges it with
// src/lib/compat.js - the app's CompanionSupport rules over compat.json.
import Pixel from './Pixel.astro';
import { trFor } from '../i18n/index.js';

const tr = trFor(Astro.url);
// What the script below writes, already in the page's language ({name}s filled in there).
const strings = {
  'supported-version': tr('The companion knows this exact version of {title}. Party, battles, map and more, on a second screen or beside the game.'),
  supported: tr('The companion reads {title}. Party, battles, map and more, on a second screen or beside the game.'),
  'unknown-hack': tr('A {base}-based ROM hack we don\'t know yet. It still plays, but the companion screen only says "not supported". Ask for it below!'),
  'in-progress': tr('{title} {version} plays in PokeDaisy, but its companion is still being built. It\'s coming!'),
  'retail-hack': tr('A ROM hack built on {base}. Only the original game is supported so far.'),
  revision: tr('{base} revision {rev} isn\'t supported yet.'),
  'other-game': tr('Not a game the companion reads (game code {code}). PokeDaisy still plays it, without the companion.'),
  gb: tr('A Game Boy game the companion doesn\'t read yet. It reads Pokémon Red, Blue, Yellow, Gold, Silver, Crystal, Crystal Clear, Prism and Polished Crystal so far.'),
  ds: tr('A DS game the companion doesn\'t read yet. It reads Pokémon Platinum, HeartGold and SoulSilver so far.'),
  '7z': tr('Unpack the .7z first, then drop the ROM (or a .zip of it).'),
  'empty-zip': tr('There\'s no .gba, .gb, .gbc or .nds file in that zip.'),
  'not-a-rom': tr('This doesn\'t look like a Game Boy, GBA or DS ROM.'),
  error: tr('Couldn\'t read that file: {error}'),
  SUPPORTED: tr('SUPPORTED'),
  'NOT YET': tr('NOT YET'),
  ERROR: tr('ERROR'),
  'BASED ON': tr('BASED ON'),
  FILE: tr('FILE'),
  'GAME CODE': tr('GAME CODE'),
  REV: tr('REV {n}'),
  SIZE: tr('SIZE'),
  MB: tr('{n} MB'),
  'ASK FOR SUPPORT': tr('ASK FOR SUPPORT'),
  CHECKING: tr('CHECKING…'),
  AGAIN: tr('DROP ANOTHER ROM'),
};
---
<div class="romcheck" data-t={JSON.stringify(strings)} data-feedback={tr.path('/feedback/')}>
  <label class="drop f-card" data-drop>
    <input type="file" accept=".gba,.gb,.gbc,.nds,.zip,.7z" hidden data-file />
    <span class="drop-art"><Pixel name="logo" scale={2} /></span>
    <span class="drop-title" data-drop-text>{tr('DROP A ROM HERE')}</span>
    <span class="drop-sub small muted">{tr('or tap to pick one: .gba, .gb, .gbc, .nds or a .zip of one')}</span>
    <span class="drop-lock small"><Pixel name="states" scale={0.667} /> {tr('Checked right here in your browser. Never uploaded.')}</span>
  </label>

  <div class="result f-list" data-result hidden aria-live="polite">
    <div class="verdict" data-verdict></div>
    <dl class="rows" data-rows></dl>
    <p class="message" data-message></p>
    <div data-actions></div>
  </div>
</div>

<style is:global>
  .romcheck { display: grid; gap: 28px; }
  .drop {
    display: grid; justify-items: center; gap: 8px; text-align: center; cursor: pointer;
    padding: calc(var(--px) * 12) calc(var(--px) * 6);
    filter: var(--hard-shadow);
    transition: transform 0.15s steps(2);
    position: relative;
  }
  .drop::after {
    content: ''; position: absolute; inset: calc(var(--px) * 3);
    outline: var(--px) dashed #c9c6d6; outline-offset: 0; pointer-events: none;
  }
  .drop:hover, .drop.over { transform: translateY(calc(var(--px) * -2)); }
  .drop.over::after { outline-color: var(--red); }
  .drop-art { animation: wobble 2.4s steps(1) infinite; transform-origin: 50% 90%; }
  .drop.busy .drop-art { animation-duration: 0.7s; }
  @keyframes wobble {
    0%, 55%, 100% { transform: rotate(0); }
    62% { transform: rotate(-15deg); }
    70% { transform: rotate(15deg); }
    78% { transform: rotate(-8deg); }
    86% { transform: rotate(0); }
  }
  .drop-title { font-size: var(--t-l); margin-top: 8px; text-shadow: var(--bold); letter-spacing: 0.0625em; }
  .drop-lock { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; color: var(--green); }

  .result { padding: calc(var(--px) * 2) calc(var(--px) * 3); color: #575656; text-shadow: var(--px) var(--px) 0 #c8c7bf; }
  .result.in { animation: open 0.42s var(--step) forwards; }
  .verdict { display: flex; align-items: center; gap: 16px; font-size: var(--t-l); margin-bottom: 8px; }
  .verdict .stamp { padding: 0 12px; text-shadow: none; }
  .rows { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 2px 24px; margin: 8px 0 16px; font-size: var(--t-m); }
  .rows dt { color: #575656; }
  .rows dd { margin: 0; color: #cb0707; text-shadow: var(--px) var(--px) 0 #e0a564; overflow-wrap: anywhere; }
  .rows dd.plain { color: #8c8c94; text-shadow: none; }
  .message { color: #3c3b45; text-shadow: none; margin-bottom: 8px; }
  [data-actions] { display: flex; flex-wrap: wrap; gap: 16px; }
  @media (max-width: 760px) { .rows { grid-template-columns: 1fr; gap: 0; } .rows dd { margin-bottom: 6px; } }
</style>

<script>
  import data from '../data/compat.json';
  import { checkFile } from '../lib/compat.js';
  import { track } from '../lib/analytics.js';
  import { fill } from '../i18n/fill.js';

  // Which message a verdict gets (its text comes from the page: data-t).
  const message = (v: any) => (v.status === 'unsupported' ? v.reason : v.version ? 'supported-version' : 'supported');
  const STAMPS: Record<string, [string, string]> = {
    supported: ['SUPPORTED', 'f-pillGreen'],
    unsupported: ['NOT YET', 'f-pillRed'],
  };

  for (const root of document.querySelectorAll<HTMLElement>('.romcheck')) {
    const t: Record<string, string> = JSON.parse(root.dataset.t!);
    const drop = root.querySelector<HTMLElement>('[data-drop]')!;
    const input = root.querySelector<HTMLInputElement>('[data-file]')!;
    const dropText = root.querySelector<HTMLElement>('[data-drop-text]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const verdictEl = root.querySelector<HTMLElement>('[data-verdict]')!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const messageEl = root.querySelector<HTMLElement>('[data-message]')!;
    const actions = root.querySelector<HTMLElement>('[data-actions]')!;

    const row = (label: string, value: string, plain = false) => {
      const dt = document.createElement('dt');
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.textContent = value;
      if (plain) dd.className = 'plain';
      rows.append(dt, dd);
    };

    // ASK FOR SUPPORT: the website's game request form, filled in through the #hash (stays in the browser -
    // a hash isn't sent to the server). It posts to GitHub's Game requests, or links there for an account.
    const formLink = (r: any) => {
      const params = new URLSearchParams({
        game: r.name.replace(/\.[^.]+$/, ''),
        game_code: r.code ? `${r.code} (rev ${r.rev})${r.platform === 'nds' ? ' DS' : ''}` : 'Game Boy',
        size: String(r.size),
        sha1: r.sha1,
      });
      const a = document.createElement('a');
      a.className = 'btn f-btn h-btnHot small';
      a.href = `${root.dataset.feedback}#${params}`;
      a.textContent = t['ASK FOR SUPPORT'];
      return a;
    };

    const check = async (file: File) => {
      dropText.textContent = t.CHECKING;
      drop.classList.add('busy');
      result.hidden = true;
      result.classList.remove('in');
      rows.replaceChildren();
      actions.replaceChildren();
      verdictEl.replaceChildren();
      try {
        const r: any = await checkFile(data, file.name, new Uint8Array(await file.arrayBuffer()));
        const v = r.verdict;
        const [stampText, stampFrame] = STAMPS[v.status];
        const stamp = document.createElement('span');
        stamp.className = `stamp chip ${stampFrame}`;
        stamp.textContent = t[stampText];
        const name = document.createElement('span');
        name.textContent = v.title ? (v.version ? `${v.title} ${v.version}` : v.title) : v.base ?? r.name;
        verdictEl.append(stamp, name);
        if (v.base && v.base !== v.title) row(t['BASED ON'], v.base);
        row(t.FILE, r.name, true);
        if (r.code) row(t['GAME CODE'], `${r.code}  ${fill(t.REV, { n: r.rev })}`);
        if (r.size) row(t.SIZE, fill(t.MB, { n: (r.size / 1048576).toLocaleString(document.documentElement.lang, { maximumFractionDigits: r.size % 1048576 ? 1 : 0, minimumFractionDigits: r.size % 1048576 ? 1 : 0 }) }));
        if (r.sha1) row('SHA-1', r.sha1, true);
        messageEl.textContent = fill(t[message(v)], { ...r, ...v });
        // The verdict alone: never the file's name, code or hash.
        track('rom_check', { verdict: v.status, reason: v.reason });
        if (r.sha1 && (['unknown-hack', 'retail-hack', 'revision', 'other-game', 'gb', 'ds'].includes(v.reason))) {
          actions.append(formLink(r));
        }
      } catch (e) {
        const stamp = document.createElement('span');
        stamp.className = 'stamp chip f-pillRed';
        stamp.textContent = t.ERROR;
        verdictEl.append(stamp);
        messageEl.textContent = fill(t.error, { error: (e as Error).message });
        track('rom_check', { verdict: 'error' });
      }
      drop.classList.remove('busy');
      dropText.textContent = t.AGAIN;
      result.hidden = false;
      result.classList.add('in');
    };

    input.addEventListener('change', () => input.files?.[0] && check(input.files[0]));
    drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('over');
      const file = e.dataTransfer?.files?.[0];
      if (file) check(file);
    });
  }
</script>
