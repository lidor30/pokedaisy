---
// The DOWNLOAD cards (src/lib/downloads.js): a card per platform, a row per file with who it's for, its name and size,
// and the platform's install guide under them. A file no release carries yet reads SOON; Windows and iOS are cards
// of their own, greyed.
import Pixel from './Pixel.astro';
import { getReleases } from '../lib/releases.js';
import { downloadsFrom, formatSize } from '../lib/downloads.js';
import { trFor, langOfPath, DEFAULT_LANG } from '../i18n/index.js';

const tr = trFor(Astro.url);
const lang = langOfPath(Astro.url.pathname);
const platforms = downloadsFrom(await getReleases());
// The 3DS and Linux guides come in every site language (docs/manual/translations/); the rest of the manual is English.
const guide = (p: { guide: string; localGuide?: boolean }) =>
  p.localGuide && lang !== DEFAULT_LANG ? `/${lang}${p.guide}` : p.guide;
const main = platforms.filter((p) => !p.soon);
const soon = platforms.filter((p) => p.soon);
---
<div class="dl" data-track-where="downloads">
  <div class="dl-grid">
    {main.map((p, i) => (
      <article class="dl-card f-card" data-reveal style={`--i:${i}`} id={`download-${p.id}`}>
        <header class="dl-head">
          <span class="dl-icon"><Pixel name={p.icon} scale={0.667} /></span>
          <div>
            <h3 class="dl-name">{p.name}{p.preview && <span class="chip f-pillYellow">{tr('PREVIEW')}</span>}</h3>
            <p class="small muted">{tr(p.text)}</p>
          </div>
        </header>
        <ul class="dl-files">
          {p.files.map((f) => (
            <li>
              {f.url ? (
                <a class="dl-file f-btn h-btnHot" href={f.url} download>
                  <Pixel name={f.icon} scale={0.334} />
                  <span class="dl-what"><span class="dl-label">{tr(f.label)}</span><span class="tiny muted">{f.file} · {formatSize(f.size)}</span></span>
                  <Pixel name="download" scale={0.667} />
                </a>
              ) : (
                <span class="dl-file off">
                  <Pixel name={f.icon} scale={0.334} />
                  <span class="dl-what"><span class="dl-label">{tr(f.label)}</span>{f.file && <span class="tiny muted">{f.file}</span>}</span>
                  <span class="chip f-pillGrey">{tr('SOON')}</span>
                </span>
              )}
            </li>
          ))}
        </ul>
        <a class="dl-guide small" href={guide(p)}><Pixel name="guide" scale={0.5} /> {tr('HOW TO INSTALL')}</a>
      </article>
    ))}
  </div>
  <div class="dl-soon">
    {soon.map((p) => (
      <div class="dl-soon-item">
        <Pixel name={p.icon} scale={0.334} />
        <span class="dl-label">{p.name}</span>
        <span class="chip f-pillGrey">{tr('COMING SOON')}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .dl { display: grid; gap: 28px; }
  /* Android and the 3DS side by side (one file each), Linux under them across the width (six files, three a row). */
  .dl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; align-items: stretch; }
  .dl-card { align-content: start; }
  #download-linux { grid-column: 1 / -1; order: 1; }
  #download-linux .dl-files { grid-template-columns: repeat(3, 1fr); }
  .dl-card { display: grid; gap: 18px; grid-template-rows: auto 1fr auto; padding: calc(var(--px) * 7); filter: var(--hard-shadow); }
  .dl-head { display: flex; gap: 16px; align-items: flex-start; }
  .dl-icon { display: inline-flex; min-width: calc(var(--px) * 22); justify-content: center; }
  .dl-name { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: var(--t-l); letter-spacing: 0.0625em; text-shadow: var(--bold); margin-bottom: 4px; }
  .dl-files { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .dl-file { display: grid; grid-template-columns: 34px 1fr auto; gap: 12px; align-items: center; padding: 10px 12px; text-decoration: none; color: var(--ink); }
  .dl-file.off { opacity: 0.6; }
  .dl-what { display: grid; gap: 2px; min-width: 0; }
  .dl-what .tiny { overflow-wrap: anywhere; }
  .dl-label, .dl-guide { font-family: var(--font-pixel); }
  .dl-label { font-size: var(--t-s); letter-spacing: 0.03em; }
  a.dl-file:hover .dl-label { color: var(--red); }
  .dl-guide { display: inline-flex; align-items: center; gap: 8px; font-size: var(--t-s); color: var(--blue, #3d6fe0); text-decoration: none; letter-spacing: 0.0625em; justify-self: start; }
  .dl-guide:hover { text-decoration: underline; }
  .dl-soon { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px 40px; }
  .dl-soon-item { display: inline-flex; align-items: center; gap: 12px; color: var(--muted); }
  @media (max-width: 1080px) { #download-linux .dl-files { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .dl { gap: 20px; }
    .dl-grid, #download-linux .dl-files { grid-template-columns: 1fr; }
    .dl-grid { gap: 18px; }
    .dl-card { padding: calc(var(--px) * 6); gap: 14px; }
  }
</style>
