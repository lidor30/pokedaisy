  .fcur { display: inline-flex; width: 0; overflow: hidden; transition: width 0.1s steps(1); }
  @keyframes blink { 50% { opacity: 0; } }
  .tabs-view { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 420px); justify-content: center; gap: 48px; align-items: center; }
  .tabs-screen { display: grid; padding: calc(var(--px) * 3); filter: var(--hard-shadow); }
  .tabs-screen img { grid-area: 1 / 1; display: block; width: 100%; aspect-ratio: 1240 / 1080; opacity: 0; transition: opacity 0.3s ease; }
