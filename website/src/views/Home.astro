  .tabs-list { display: grid; gap: 4px; }
  .tab-item { display: grid; gap: 2px; text-align: left; font: inherit; color: inherit; background: none; border: 0; padding: 10px 14px; cursor: pointer; }
  .tab-name { display: flex; align-items: center; gap: 8px; font-size: var(--t-m); letter-spacing: 0.0625em; color: var(--muted); }
  .tab-text { display: none; color: var(--ink-2); }
  .tab-item:hover .tab-name { color: var(--ink); }
  .tab-item.on { background: var(--card, rgba(255, 255, 255, 0.7)); filter: var(--hard-shadow); }
  .tab-item.on .tab-name { color: #cb0707; text-shadow: var(--bold); }
  .tab-item.on .fcur { width: calc(var(--px) * 5); animation: blink 0.6s steps(1) infinite; }
  .tab-item.on .tab-text { display: block; }

  /* EXPAND, one game at a time under tabs (the game pages' viewer). */
  .viewer { max-width: 1000px; margin: 0 auto; display: grid; gap: 18px; }
  .viewer-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .viewer-tabs .btn.on { color: var(--red); text-shadow: var(--bold); }
  .viewer-screen { display: grid; padding: calc(var(--px) * 3); filter: var(--hard-shadow); }
  .viewer-screen img { grid-area: 1 / 1; display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; opacity: 0; transition: opacity 0.3s ease; }
  .viewer-screen img.on { opacity: 1; }

  /* The clips */
  .demo-block { display: grid; grid-template-columns: minmax(0, 620px) 1fr; gap: 56px; align-items: center; }
  .demo-block.flip { grid-template-columns: 1fr minmax(0, 620px); }
  .clip { display: block; padding: calc(var(--px) * 3); filter: var(--hard-shadow); }
  .clip video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .makeover { position: relative; padding-bottom: 14%; }
  .makeover .inset { position: absolute; right: -4%; bottom: 0; width: 42%; }
  .battle-pair { display: grid; gap: 16px; justify-items: center; }
  .battle-pair > img { display: block; width: 100%; aspect-ratio: 16 / 9; padding: calc(var(--px) * 3); filter: var(--hard-shadow); }
  .battle-styles { display: grid; width: 64%; padding: calc(var(--px) * 3); filter: var(--hard-shadow); }
  .battle-styles img { grid-area: 1 / 1; display: block; width: 100%; aspect-ratio: 1240 / 1080; opacity: 0; transition: opacity 0.5s ease; }
  .battle-styles img.on { opacity: 1; }
  .more-link { margin-top: 40px; display: flex; justify-content: center; }

  /* Player */
  .player-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 32px; }
  .player-item { display: flex; gap: 20px; align-items: flex-start; }
  .player-icon { display: inline-flex; padding: calc(var(--px) * 3); filter: var(--hard-shadow); transition: transform 0.2s steps(2); }
  .player-item:hover .player-icon { transform: rotate(-8deg) translateY(calc(var(--px) * -2)); }
  .player-name { font-size: var(--t-m); margin-bottom: 6px; text-shadow: var(--bold); letter-spacing: 0.0625em; }

  /* Devices */
  .device-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 24px; }
