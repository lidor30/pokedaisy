</style>

<script>
  import { releaseDownloads } from '../lib/releases.js';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The one-screen handheld's companion window opens and closes as its demo plays (CompanionDemo); without
  // motion it just stays open.
  if (reduce) document.querySelector<HTMLElement>('[data-single-device]')?.classList.add('open');

  // The device's screens step through their shots, the bottom one half a beat after the top.
  for (const box of document.querySelectorAll<HTMLElement>('[data-cycle]')) {
    const imgs = [...box.querySelectorAll('img')];
    if (reduce || imgs.length < 2) continue;
    let at = 0;
    const step = () => { imgs[at].classList.remove('on'); at = (at + 1) % imgs.length; imgs[at].classList.add('on'); };
    setTimeout(() => setInterval(step, Number(box.dataset.cycle)), Number(box.dataset.offset ?? 0));
  }

  // Tabs: the companion's (a list beside its shot) and EXPAND's games (buttons over the shot). A viewer with data-auto
  // steps to the next tab by itself every that many ms while it's on screen and the pointer isn't over it; a pick starts
  // the count again. Not with reduced motion.
  for (const viewer of document.querySelectorAll<HTMLElement>('[data-viewer]')) {
    const tabs = [...viewer.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const imgs = [...viewer.querySelectorAll('.tabs-screen img, .viewer-screen img')];
    let at = 0;
    const show = (i: number) => {
      at = i;
      for (const list of [tabs, imgs]) list.forEach((el, j) => el.classList.toggle('on', i === j));
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
    };
    const every = Number(viewer.dataset.auto ?? 0);
    let timer = 0, visible = false, hovered = false;
    const restart = () => {
      clearInterval(timer);
      if (every && !reduce && visible && !hovered) timer = window.setInterval(() => show((at + 1) % tabs.length), every);
    };
    tabs.forEach((tab, i) => tab.addEventListener('click', () => { show(i); restart(); }));
    if (every && !reduce) {
      viewer.addEventListener('pointerenter', () => { hovered = true; restart(); });
      viewer.addEventListener('pointerleave', () => { hovered = false; restart(); });
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; restart(); }, { threshold: 0.3 }).observe(viewer);
    }
  }

  // The clips play while they're on screen, silent and looping; with reduced motion they wait for a tap on play.
  const clips = [...document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')];
  if (reduce) {
    for (const v of clips) { v.removeAttribute('autoplay'); v.pause(); v.controls = true; }
  } else {
    const watch = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      }
    }, { threshold: 0.25 });
    clips.forEach((v) => watch.observe(v));
  }

  // The download count, fresh from GitHub (the build's number stays if that fails or is rate-limited).
  const dl = document.querySelector<HTMLElement>('[data-downloads]');
  fetch('https://api.github.com/repos/lidor30/pokedaisy/releases?per_page=100', { headers: { Accept: 'application/vnd.github+json' } })
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((list: any[]) => {
      const n = releaseDownloads(list);
      if (dl && n > Number(dl.querySelector('[data-downloads-count]')!.textContent!
        .replace(/\D/g, ''))) {
        dl.querySelector('[data-downloads-count]')!.textContent = n.toLocaleString(document.documentElement.lang);
        dl.hidden = false;
      }
    })
    .catch(() => {});

</script>
