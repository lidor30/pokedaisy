---
import Base from '../layouts/Base.astro';
import Pixel from '../components/Pixel.astro';
import RomCheck from '../components/RomCheck.astro';
import Downloads from '../components/Downloads.astro';
import HeroDevice from '../components/HeroDevice.astro';
import HeroSingleDevice from '../components/HeroSingleDevice.astro';
import data from '../data/compat.json';
import { REPO_URL, formatDate, getReleases, getDownloads, highlights } from '../lib/releases.js';
import { REDDIT_URL, DISCORD_URL, KOFI_URL, PATREON_URL, COFFEE_URL } from '../lib/links.js';
import { trFor, msg } from '../i18n/index.js';

const tr = trFor(Astro.url);

const releases = await getReleases();
const latest = releases[0];
const download = latest?.apk ?? `${REPO_URL}/releases/latest`;
const downloads = await getDownloads();

const gameCount = new Set(data.matrix.rows.map((r) => r.game)).size;
const hackCount = new Set(data.hacks.map((h) => h.title)).size;

// The companion's tabs, each a real shot of the bottom screen (FireRed on the Thor, website/public/media/).
// In the app's own order: the tab bar's tabs, BATTLE (which takes the bar's last place in a fight), then MORE's.
const companion = [
  ['party', msg('PARTY'), msg('Your team in your game\'s own party screen. Tap a Pokémon for its stats, moves, IVs and EVs.')],
  ['dex', msg('DEX'), msg('Seen and caught marks, with full entries: types, stats, abilities and dex text.')],
  ['map', msg('MAP'), msg('The region map with you on it. Tap a place to name it, or jump to any town.')],
  ['bag', msg('BAG'), msg('Every pocket, with the game\'s item icons and descriptions.')],
  ['guide', msg('GUIDE'), msg('Hints first, answers on a second tap: what\'s here, the next boss, evolutions.')],
  ['battle-gen5', msg('BATTLE'), msg('Opens by itself in a fight: every matchup, the best pick, the foe\'s whole team.')],
  ['boxes', msg('BOXES'), msg('Your PC\'s boxes, laid out like the game\'s. Tap a Pokémon for its summary.')],
  ['nuzlocke', msg('NUZLOCKE'), msg('Keeps score of a Nuzlocke run: the first encounter in each area, and every fainted Pokémon out for good.')],
];
// EXPAND in one game after another (the Thor's top screen). Game names stay as they are in every language.
const expandShots = [
  ['firered-field', 'FireRed'], ['soulgold-expand', 'SoulGold'], ['rogue-expand', 'Emerald Rogue'], ['lazarus-expand', 'Lazarus'],
  ['monomyth-expand', 'Monomyth'], ['mariomon-expand', 'Super Mariomon'], ['recharged-yellow-expand', 'Recharged Yellow'], ['yellow-field', 'Yellow'],
];
// Everything else, short: the chores and the player.
const more = [
  ['pc', msg('PC ANYWHERE'), msg('Open your PC boxes from the bag, the HUD or the quick menu, wherever you stand. No walk back to a Pokémon Center.')],
  ['ff', msg('SMART FAST-FORWARD'), msg('Full speed on the road, normal speed in menus and on the map. Battles stay fast.')],
  ['music', msg('FF MUSIC'), msg('The song keeps its normal tempo while the game runs fast. No chipmunks.')],
  ['grassOff', msg('WILD ENCOUNTERS OFF'), msg('One switch stops random encounters in the grass and on the water. Fishing and the story\'s battles still happen; switch it back any time.')],
  ['tmDisc', msg('REUSABLE TMS'), msg('A TM stays in your bag after it teaches a move, so one is enough for the whole team.')],
  ['spray', msg('REPEL IN ONE PRESS'), msg('Use a Repel from the quick menu or the bag in one press. The HUD counts down the steps it has left.')],
  ['run', msg('AUTO-RUN'), msg('Run without holding B, and run inside buildings too.')],
  ['tv', msg('SHADERS'), msg('An LCD grid, scanlines or a CRT, plus the colours the GBA\'s screen really showed, unlit backing and all.')],
  ['dpad', msg('CONTROLS'), msg('Remap every button and hotkey. Touch controls when no pad is connected.')],
  ['star', msg('ACHIEVEMENTS'), msg('RetroAchievements while you play, with the game\'s own level-up fanfare.')],
  ['single', msg('COMPANION WINDOW'), msg('On one screen, every tab in a window over the game, or a panel locked beside it. The D-pad and A work it like the game\'s menus.')],
  ['clock', msg('STATUS BAR'), msg('Game, place, money, clock and battery in a strip above the game.')],
];
const media = (name: string) => `/media/${name}`;
const deviceList = [
  ['dual', 'AYN THOR', msg('Made for it, tested daily.'), msg('TESTED'), 'f-pillGreen'],
  ['dual', 'RETROID POCKET DUO LITE', msg('Its 4:3 bottom screen gets a layout of its own. The original Duo should work too.'), msg('SUPPORTED'), 'f-pillGreen'],
  ['dual', 'ANBERNIC RG DS', msg('SWAP SCREENS puts the game on its top display.'), msg('SHOULD WORK'), 'f-pillYellow'],
  ['single', msg('ONE SCREEN'), msg('The companion opens as a window over the game or a panel beside it, with the HUD and quick menu on the game. Tested on the Retroid Pocket 6.'), msg('TESTED'), 'f-pillBlue'],
  ['phone', msg('PHONES, UPRIGHT'), msg('Hold an Android phone upright: the game on top, the companion under it. New: so far checked in screenshots only.'), msg('NEW'), 'f-pillRed'],
  ['moreDevice', msg('COMING SOON'), msg('More handhelds, tablets and foldables. Want yours supported? Ask for it below.'), msg('SOON'), 'f-pillGrey'],
];
const ticker = ['GB · GBC · GBA · DS', msg('TWO SCREENS OR ONE'), msg('PARTY'), msg('BAG'), msg('BATTLE'), msg('MAP'), msg('DEX'), msg('GUIDE'), msg('TRAINER CARD'), msg('SAVE STATES'), msg('HUD'), msg('QUICK MENU'), msg('EXPAND'), msg('PC ANYWHERE'), msg('FREE FLIGHT'), msg('FAST-FORWARD'), msg('SHADERS'), msg('ACHIEVEMENTS')]
  .map((t) => tr(t)).concat(tr('{n} GAMES', { n: gameCount }));
const title = 'POKEDAISY'.split('');
---
<Base
  title={tr('PokeDaisy: Game Boy Pokémon with a live companion')}
  description={tr('A free player for Game Boy, Game Boy Color, Game Boy Advance and Nintendo DS Pokémon games on Android handhelds with two screens or one: the game, and a live companion with your party, battles, map, dex and guide on the second screen or right beside it, plus a HUD and a quick menu on the game screen.')}
>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero-copy" data-track-where="hero">
      <div class="hero-head">
        <div class="hero-mark">
          <span class="mark-ball"><Pixel name="logo" scale={1} label="PokeDaisy" /></span>
          {[0, 1, 2].map((i) => <span class={`twinkle t${i}`}><Pixel name="spark" scale={1} /></span>)}
        </div>
        <h1 class="hero-title" aria-label="PokeDaisy">
          {title.map((ch, i) => <span class:list={['drop-letter', i < 4 && 'red']} style={`--d:${i}`} aria-hidden="true">{ch}</span>)}
        </h1>
      </div>
      <p class="hero-lead">{tr('Pokémon, played better. Game Boy to DS, with a live companion, a widescreen overworld, a HUD and quick menu, and every chore one button away.')}</p>
      <div class="cta">
        <a class="btn f-primary h-primaryHot primary big" href={download}>
          <Pixel name="download" scale={1} /> {tr('DOWNLOAD')}{latest && <span class="ver">v{latest.version}</span>}
        </a>
        <!-- The APK is one tap; Linux and the 3DS are a card each further down. -->
        <a class="platforms" href="#download">
          <Pixel name="android" scale={0.334} /><Pixel name="tux" scale={0.334} /><Pixel name="n3ds" scale={0.334} />
          <span>{tr('ALL PLATFORMS')}</span>
        </a>
      </div>
      <!-- The community: the Discord for help and chat, the subreddit. -->
      <div class="cta community">
        <a class="btn f-discord h-discordHot" href={DISCORD_URL}><Pixel name="discord" scale={0.667} /> {tr('JOIN THE DISCORD')}</a>
        <a class="btn f-reddit h-redditHot" href={REDDIT_URL}><Pixel name="reddit" scale={0.667} /> r/POKEDAISY</a>
      </div>
      <a class="downloads" href={`${REPO_URL}/releases`} data-downloads hidden={!downloads}>
        <Pixel name="download" scale={1} />
        <span class="dl-count" data-downloads-count>{downloads.toLocaleString(tr.locale)}</span>
        <span class="dl-label">{tr('DOWNLOADS')}</span>
      </a>
      <p class="hero-meta small muted"><span>Android 8.0+</span><span>{tr('Free and open source')}</span><span>{tr('No ads')}</span></p>
    </div>
    <div class="hero-art">
      <div class="glow"></div>
      <!-- Both at once, with the real app on them: the Thor at the back (a flight on top, the companion's tabs
           below), a one-screen handheld in front stepping through EXPAND in other games. -->
      <div class="duo">
        <div class="duo-dual">
          <HeroDevice>
            <div slot="top" class="screen-shots">
              <video class="on" src={media('free-flight.mp4')} poster={media('free-flight-poster.webp')} autoplay muted loop playsinline aria-label={tr('Take off and fly anywhere')} data-autoplay></video>
            </div>
            <div slot="bottom" class="screen-shots" data-cycle="3200">
              {companion.slice(0, 5).map(([shot, name], i) => <img src={media(`companion-${shot}.webp`)} alt={tr('The companion\'s {tab}', { tab: tr(name) })} class:list={[i === 0 && 'on']} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
            </div>
          </HeroDevice>
        </div>
        <div class="duo-single">
          <HeroSingleDevice>
            <div slot="screen" class="screen-shots" data-cycle="3200" data-offset="1600">
              {expandShots.slice(1, 6).map(([shot, game], i) => <img src={media(`${shot}.webp`)} alt={tr('{game} with EXPAND', { game })} class:list={[i === 0 && 'on']} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
            </div>
          </HeroSingleDevice>
        </div>
      </div>
      <p class="tiny muted shot-note">{tr('Every picture here is the real app on real games. Pokémon and the games belong to their owners, and no games are included.')}</p>
    </div>
  </section>

  <!-- Ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => ticker.map((t) => <span class="tick">{t}<Pixel name="spark" scale={1} /></span>))}
    </div>
  </div>

  <!-- Companion: its tabs, one real shot at a time -->
  <section class="block container" id="features">
    <div class="section-head center">
      <span class="eyebrow">{tr('THE COMPANION')}</span>
      <h2 class="heading">{tr('A live companion that reads your game')}</h2>
      <p class="lead">{tr('On the bottom screen, or in a window over the game on one. Everything is read straight from the game as you play, and drawn in its own menu style. No typing, no alt-tabbing to a wiki.')}</p>
    </div>
    <div class="tabs-view" data-viewer data-auto="2500" data-reveal="fade">
      <div class="tabs-screen f-card">
        {companion.map(([shot, name], i) => <img src={media(`companion-${shot}.webp`)} alt={tr('The companion\'s {tab}', { tab: tr(name) })} class:list={[i === 0 && 'on']} loading="lazy" decoding="async" />)}
      </div>
      <div class="tabs-list" role="tablist" aria-label={tr('THE COMPANION')}>
        {companion.map(([, name, text], i) => (
          <button type="button" role="tab" class:list={['tab-item', i === 0 && 'on']} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="tab-name"><span class="fcur"><Pixel name="cursor" scale={1} /></span>{tr(name)}</span>
            <span class="small tab-text">{tr(text)}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPAND, game after game -->
  <section class="block container">
    <div class="section-head center">
      <span class="eyebrow">{tr('EXPAND')}</span>
      <h2 class="heading">{tr('The whole screen, not black bars')}</h2>
      <p class="lead">{tr('The map drawn past the game\'s edges to fill a wide screen, rebuilt every frame from the game itself. ZOOM steps out to see more of the area, and the right stick looks around.')}</p>
    </div>
    <div class="viewer" data-viewer data-reveal="fade">
      <div class="viewer-tabs" role="tablist" aria-label={tr('EXPAND')}>
        {expandShots.map(([, game], i) => <button type="button" role="tab" class:list={['btn f-btn h-btnHot small', i === 0 && 'on']} aria-selected={i === 0 ? 'true' : 'false'}>{game}</button>)}
      </div>
      <div class="viewer-screen f-card">
        {expandShots.map(([shot, game], i) => <img src={media(`${shot}.webp`)} alt={tr('{game} with EXPAND', { game })} class:list={[i === 0 && 'on']} loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  <!-- Quick menu + HUD -->
  <section class="block container demo-block">
    <div class="demo-art clip f-card" data-reveal="fade">
      <!-- Emerald on the Thor: the quick menu (FLY, TAKE OFF, BIKE, ROD, fast-forward) and the HUD's WILD, BAG and MAP. -->
      <video src={media('on-the-game-screen.mp4')} poster={media('on-the-game-screen-poster.webp')} muted loop playsinline preload="none" aria-label={tr('Everything at hand, right on the game')} data-autoplay></video>
    </div>
    <div class="demo-copy" data-reveal="fade" style="--i:1">
      <span class="eyebrow">{tr('ON THE GAME SCREEN')}</span>
      <h2 class="heading">{tr('Everything at hand, right on the game')}</h2>
      <p class="lead">{tr('One button opens a ring of shortcuts: your PC, FLY, REPEL, BIKE, ROD, wild encounters on and off, save states, fast-forward. Aim with the stick.')}</p>
      <p class="lead small">{tr('Your party, a minimap, your Poké Balls, the Repel\'s steps left and PC / BAG / WILD buttons on the game screen as you walk, like a modern Pokémon game. Tap any of it.')}</p>
    </div>
  </section>

  <!-- Free flight -->
  <section class="block container demo-block flip">
    <div class="demo-copy" data-reveal="fade">
      <span class="eyebrow">{tr('FREE FLIGHT')}</span>
      <h2 class="heading">{tr('Take off and fly anywhere')}</h2>
      <p class="lead">{tr('TAKE OFF from the map or the quick menu and fly over the whole region on your Pokémon\'s bird, the map drawn past the screen\'s edges. FLY then takes you to a town over the real map, not a cut.')}</p>
    </div>
    <div class="demo-art clip f-card" data-reveal="fade" style="--i:1">
      <video src={media('free-flight.mp4')} poster={media('free-flight-poster.webp')} muted loop playsinline preload="none" aria-label={tr('Take off and fly anywhere')} data-autoplay></video>
    </div>
  </section>

  <!-- Makeover -->
  <section class="block container demo-block">
    <div class="demo-art makeover" data-reveal="fade">
      <div class="clip f-card">
        <video src={media('fly-on.mp4')} poster={media('fly-on-poster.webp')} muted loop playsinline preload="none" aria-label={tr('Ride in style')} data-autoplay></video>
      </div>
      <div class="clip inset f-card" aria-hidden="true">
        <video src={media('follower.mp4')} poster={media('follower-poster.webp')} muted loop playsinline preload="none" data-autoplay></video>
      </div>
    </div>
    <div class="demo-copy" data-reveal="fade" style="--i:1">
      <span class="eyebrow">{tr('MAKEOVER')}</span>
      <h2 class="heading">{tr('Ride in style')}</h2>
      <p class="lead">{tr('Swap the bird for a helicopter, a plane, a balloon or a zeppelin. Put your lead Pokémon behind you, ride a motorcycle, or play as another game\'s hero.')}</p>
    </div>
  </section>

  <!-- Battle -->
  <section class="block container demo-block flip">
    <div class="demo-copy" data-reveal="fade">
      <span class="eyebrow">{tr('IN BATTLE')}</span>
      <h2 class="heading">{tr('Know every matchup at a glance')}</h2>
      <p class="lead">{tr('When a fight starts the companion jumps to BATTLE. FIGHT shows each move\'s effect on the foe, INFO both Pokémon with the foe\'s weaknesses, and SUGGESTIONS the best Pokémon and move for this fight.')}</p>
      <p class="lead small">{tr('On FireRed and Emerald the buttons play the battle for you: fight, switch or run without reaching for the controls.')}</p>
    </div>
    <div class="demo-art battle-pair" data-reveal="fade" style="--i:1">
      <img class="f-card" src={media('firered-battle.webp')} alt={tr('{game} on PokeDaisy: {shot}', { game: 'FireRed', shot: tr('IN BATTLE') })} loading="lazy" decoding="async" />
      <!-- BATTLE STYLE's two looks taking turns: GEN 4's big buttons, then GEN 5's battle screen. -->
      <div class="battle-styles f-card" data-cycle="2800">
        <img class="on" src={media('companion-battle.webp')} alt={tr('The companion\'s {tab}', { tab: tr('BATTLE') })} loading="lazy" decoding="async" />
        <img src={media('companion-battle-gen5.webp')} alt={tr('The companion\'s {tab}', { tab: tr('BATTLE') })} loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Everything else -->
  <section class="block container">
    <div class="section-head center">
      <span class="eyebrow">{tr('QUALITY OF LIFE')}</span>
      <h2 class="heading">{tr('Less walking back, more playing')}</h2>
    </div>
    <div class="player-grid">
      {more.map(([icon, name, text], i) => (
        <article class="player-item" data-reveal style={`--i:${i % 3}`}>
          <span class="player-icon f-card"><Pixel name={icon} scale={1} /></span>
          <div>
            <h3 class="player-name">{tr(name)}</h3>
            <p class="small muted">{tr(text)}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="center more-link"><a class="btn f-btn h-btnHot small" href="/docs/"><Pixel name="guide" scale={0.5} /> {tr('READ THE MANUAL')}</a></p>
  </section>

  <!-- Download, platform by platform -->
  <section class="block container" id="download">
    <div class="section-head center">
      <span class="eyebrow">{tr('DOWNLOAD')}</span>
      <h2 class="heading">{tr('Get PokeDaisy')}</h2>
      <p class="lead">{tr('Free on every platform, and open source. Pick yours, then follow its install guide.')}</p>
    </div>
    <Downloads />
  </section>

  <!-- Devices -->
  <section class="block container">
    <div class="section-head">
      <span class="eyebrow">{tr('DEVICES')}</span>
      <h2 class="heading">{tr('Two screens or one')}</h2>
      <p class="lead">{tr('On a dual-screen handheld the companion gets a screen of its own. On one screen it opens in a window over the game or a panel beside it, or under it on a phone held upright. On a dual-screen handheld, SINGLE SCREEN plays it that way and frees the second screen for other apps.')}</p>
    </div>
    <div class="device-grid">
      {deviceList.map(([icon, name, text, status, frame], i) => (
        <article class:list={['device f-card', icon === 'moreDevice' && 'soon']} data-reveal style={`--i:${i}`}>
          <Pixel name={icon} scale={1.334} />
          <h3 class="device-name">{tr(name)}</h3>
          <p class="small muted">{tr(text)}</p>
          <span class={`chip ${frame}`}>{tr(status)}</span>
          {icon === 'moreDevice' && <a class="btn f-btn h-btnHot small" href={tr.path('/feedback/#feature')}>{tr('REQUEST A DEVICE')}</a>}
        </article>
      ))}
    </div>
  </section>

  <!-- Games -->
  <section class="block container" id="games">
    <div class="section-head">
      <span class="eyebrow">{tr('SUPPORTED GAMES')}</span>
      <h2 class="heading">{tr('{n} games and counting', { n: gameCount })}</h2>
      <p class="lead">{tr('Red to Crystal on the Game Boy, FireRed, LeafGreen, Emerald, Ruby and Sapphire in six languages, Platinum, HeartGold, SoulSilver, Black, White, Black 2 and White 2 on the DS, and {n} ROM hacks, with more on the way.', { n: hackCount })}</p>
    </div>
    <!-- The whole table is the compatibility page's: here it was most of the page's length. -->
    <div class="cta" data-reveal="fade">
      <a class="btn f-primary h-primaryHot primary" href={tr.path('/compatibility/')}><Pixel name="logo" scale={0.334} /> {tr('SEE ALL {n} GAMES', { n: gameCount })}</a>
    </div>
  </section>

  <!-- ROM check -->
  <section class="block container check-block" id="check">
    <div class="section-head">
      <span class="eyebrow">{tr('ROM CHECK')}</span>
      <h2 class="heading">{tr('Is your ROM supported?')}</h2>
      <p class="lead">{tr('Hacks are recognised by their exact file. Drop yours in to see which game and version it is, and what the companion can do with it.')}</p>
    </div>
    <div data-reveal="fade"><RomCheck /></div>
  </section>

  <!-- What's new -->
  {latest && (
    <section class="block container">
      <div class="section-head">
        <span class="eyebrow">{tr('WHAT\'S NEW')}</span>
        <h2 class="heading">PokeDaisy {latest.version}</h2>
        <p class="lead small">{formatDate(latest.date, tr.locale)} · {tr('updates install from inside the app')}</p>
      </div>
      <article class="release f-card" data-reveal>
        <ul class="highlights" lang="en">
          {highlights(latest.body).map((h) => <li set:html={h} />)}
        </ul>
        <div class="cta" data-track-where="latest">
          <a class="btn f-primary h-primaryHot primary" href={download}><Pixel name="download" scale={0.667} /> {tr('DOWNLOAD APK')}</a>
          <a class="btn f-btn h-btnHot" href={tr.path('/releases/')}>{tr('ALL RELEASES')}</a>
        </div>
      </article>
    </section>
  )}

  <!-- Support -->
  <section class="block container" id="support">
    <div class="support f-card" data-reveal>
      <div class="cup-art" aria-hidden="true">
        <span class="steam"><Pixel name="steam" scale={4} /></span>
        <Pixel name="cup" scale={4} />
      </div>
      <div class="support-copy">
        <span class="eyebrow">{tr('SUPPORT POKEDAISY')}</span>
        <h2 class="heading">{tr('Free, no ads, nothing locked')}</h2>
        <p class="lead">{tr('If PokeDaisy made a playthrough better, you can support it on Ko-fi or Patreon, or buy me a coffee. It\'s completely optional and doesn\'t unlock anything; it helps cover the time that goes into mapping new games and ROM hacks.')}</p>
        <div class="cta">
          <a class="btn f-kofi h-kofiHot big" href={KOFI_URL}><Pixel name="kofi" scale={0.667} /> KO-FI</a>
          <a class="btn f-patreon h-patreonHot big" href={PATREON_URL}><Pixel name="patreon" scale={0.667} /> PATREON</a>
          <a class="btn f-coffee h-coffeeHot big" href={COFFEE_URL}><Pixel name="cup" scale={0.667} /> {tr('BUY ME A COFFEE')}</a>
        </div>
        <p class="small muted">{tr('Bug reports, game requests and a star help just as much:')}</p>
        <div class="cta">
          <a class="btn f-btn h-btnHot small" href="/docs/"><Pixel name="guide" scale={0.5} /> {tr('READ THE MANUAL')}</a>
          <a class="btn f-btn h-btnHot small" href={tr.path('/feedback/#bug')}><Pixel name="bug" scale={0.667} /> {tr('REPORT A BUG')}</a>
          <a class="btn f-btn h-btnHot small" href={tr.path('/feedback/#game')}><Pixel name="logo" scale={0.334} /> {tr('REQUEST A GAME')}</a>
          <a class="btn f-btn h-btnHot small" href="/feedback/#feature"><Pixel name="guide" scale={0.5} /> {tr('SUGGEST A FEATURE')}</a>
          <a class="btn f-btn h-btnHot small" href={REPO_URL}><Pixel name="star" scale={0.667} /> {tr('STAR ON GITHUB')}</a>
          <a class="btn f-reddit h-redditHot small" href={REDDIT_URL}><Pixel name="reddit" scale={0.5} /> {tr('JOIN r/POKEDAISY')}</a>
          <a class="btn f-discord h-discordHot small" href={DISCORD_URL}><Pixel name="discord" scale={0.5} /> {tr('JOIN THE DISCORD')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: center; padding: 64px 0 56px; }
  .hero-head { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .hero-mark { position: relative; width: max-content; }
  .mark-ball { display: inline-block; transform-origin: 50% 85%; animation: capture 3.2s steps(1) infinite 1.2s; }
  @keyframes capture {
    0%, 52%, 100% { transform: rotate(0); }
