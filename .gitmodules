[submodule "third_party/mgba"]
	path = third_party/mgba
	url = https://github.com/mgba-emu/mgba.git
[submodule "third_party/rcheevos"]
	path = third_party/rcheevos
	url = https://github.com/RetroAchievements/rcheevos.git
[submodule "third_party/melonds"]
	path = third_party/melonds
	url = https://github.com/melonDS-emu/melonDS.git
	# The build applies third_party/patches/melonds-pokedaisy.patch here; scripts/check_melonds_patch.py checks that
	# nothing else changed.
	ignore = dirty
[submodule "third_party/dsperate"]
	path = third_party/dsperate
	url = https://github.com/beebono/DSperate.git
[submodule "third_party/dsperate-lr"]
	path = third_party/dsperate-lr
	url = https://github.com/thwonp/dsperate-lr.git
[submodule "third_party/armgba"]
	path = third_party/armgba
	url = https://github.com/ratherDashing/armGBA.git
	# The 3DS build applies third_party/patches/armgba-pokedaisy.patch here.
	ignore = dirty
[submodule "third_party/zlib"]
	path = third_party/zlib
	url = https://github.com/madler/zlib.git
