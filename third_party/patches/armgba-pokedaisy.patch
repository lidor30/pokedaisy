+// Both routines in one pass, each found only when it's in the ROM once; their first four bytes compared as a word
+// (PokeDaisy: two passes a byte at a time cost a 32 MB game's start ~0.4 s on a 3DS).
+static void findBothOnce(const uint8_t* rom, size_t size, long* start, long* stop) {
+	uint32_t a, b;
+	memcpy(&a, flashTimerStart, 4);
+	memcpy(&b, flashTimerStop, 4);
+	*start = *stop = -1;
+	bool startTwice = false, stopTwice = false;
+	for (size_t i = 0; i + 4 <= size; i += 2) {
+		uint32_t w;
+		memcpy(&w, &rom[i], 4);
+		if (w == a && i + sizeof(flashTimerStart) <= size && !memcmp(&rom[i], flashTimerStart, sizeof(flashTimerStart))) {
+			startTwice = startTwice || *start >= 0;
+			*start = (long) i;
 		}
