+			*stop = (long) i;
 		}
-		at = (long) i;
 	}
-	return at;
+	if (startTwice) *start = -1;
+	if (stopTwice) *stop = -1;
 }
 
 // Call once the game is loaded into memory that can be written, before it runs.
 bool savedataSkipFlashTimer(struct GBA* gba) {
+	long start = -2, stop = -2;
+	return savedataSkipFlashTimerAt(gba, &start, &stop);
+}
+
+// The same with the routines' places known from an earlier run of this ROM (PokeDaisy keeps them per ROM): checked
+// against the ROM's bytes, no pass. *start -2 = not known: found, and both written back (-1 = not in it once).
+bool savedataSkipFlashTimerAt(struct GBA* gba, long* startAt, long* stopAt) {
 	if (!gba->rom || gba->romSize < sizeof(flashTimerStart)) {
 		return false;
 	}
-	long const start = findOnce(gba->rom, gba->romSize, flashTimerStart, sizeof(flashTimerStart));
-	long const stop = findOnce(gba->rom, gba->romSize, flashTimerStop, sizeof(flashTimerStop));
+	long start = *startAt, stop = *stopAt;
+	if (start == -2) {
+		findBothOnce(gba->rom, gba->romSize, &start, &stop);
+		*startAt = start;
+		*stopAt = stop;
+	} else if (start >= 0 && stop >= 0 &&
+	           ((size_t) start + sizeof(flashTimerStart) > gba->romSize || (size_t) stop + sizeof(flashTimerStop) > gba->romSize ||
+	            memcmp(&gba->rom[start], flashTimerStart, sizeof(flashTimerStart)) ||
+	            memcmp(&gba->rom[stop], flashTimerStop, sizeof(flashTimerStop)))) {
+		return false;
+	}
