--- a/gba_memory.c
+++ b/gba_memory.c
@@ -2672,11 +2672,31 @@ u8 *load_gamepak_page(u32 physical_index)
   return swap_location;
 }
 
+/* PokeDaisy: a host that keeps one cartridge buffer for every game (the 3DS
+ * port's 32 MB arena, reserved at start) hands it over here; gpSP's own 1MB
+ * blocks otherwise. The arena is never freed (memory_term). */
+u8 *(*gpsp_host_rom_arena)(size_t size) = NULL;
+static int gamepak_arena;
+
 void init_gamepak_buffer(void)
 {
   unsigned i;
-  // Try to allocate up to 32 blocks of 1MB each
   gamepak_buffer_count = 0;
+  gamepak_arena = 0;
+  if (gpsp_host_rom_arena)
+  {
+    u8 *arena = gpsp_host_rom_arena((size_t)ROM_BUFFER_SIZE * gamepak_buffer_blocksize);
+    if (arena)
+    {
+      while (gamepak_buffer_count < ROM_BUFFER_SIZE)
+      {
+        gamepak_buffers[gamepak_buffer_count] = arena + (size_t)gamepak_buffer_count * gamepak_buffer_blocksize;
+        gamepak_buffer_count++;
+      }
+      gamepak_arena = 1;
+    }
+  }
+  // Try to allocate up to 32 blocks of 1MB each
   while (gamepak_buffer_count < ROM_BUFFER_SIZE)
   {
     void *ptr = malloc(gamepak_buffer_blocksize);
@@ -2779,10 +2799,13 @@ void memory_term(void)
     gamepak_file_large = NULL;
   }
 
+  if (gamepak_arena)
+    gamepak_buffer_count = 0;
   while (gamepak_buffer_count)
   {
     free(gamepak_buffers[--gamepak_buffer_count]);
   }
+  gamepak_arena = 0;
 
   if (gamepak_mini_rom)
   {
diff --git a/video_thread_sys.c b/video_thread_sys.c
index 59a6ba4..32617f1 100644
--- a/video_thread_sys.c
+++ b/video_thread_sys.c
@@ -63,13 +63,35 @@ unsigned long long vt_now_us(void)
 #include <pthread.h>
 #include <semaphore.h>
 #include <time.h>
+#ifdef __APPLE__
+/* PokeDaisy: macOS has no unnamed POSIX semaphores (sem_init fails), so the
+ * render thread's waits there are dispatch semaphores (the 3DS port's desktop
+ * simulator runs gpSP on a Mac). */
+#include <dispatch/dispatch.h>
+#endif
 
+#ifdef __APPLE__
+struct vt_sem { dispatch_semaphore_t s; };
+#else
 struct vt_sem { sem_t s; };
+#endif
 static pthread_t vt_thread;
 static int vt_thread_running;
 static void (*vt_fn)(void*);
 static void *vt_arg;
 
+#ifdef __APPLE__
+vt_sem *vt_sem_create(void)
+{
+   vt_sem *s = (vt_sem*)malloc(sizeof(vt_sem));
+   if (s)
+      s->s = dispatch_semaphore_create(0);
+   return s;
+}
+void vt_sem_destroy(vt_sem *s) { if (s) { dispatch_release(s->s); free(s); } }
+void vt_sem_post(vt_sem *s) { dispatch_semaphore_signal(s->s); }
+void vt_sem_wait(vt_sem *s) { dispatch_semaphore_wait(s->s, DISPATCH_TIME_FOREVER); }
+#else
 vt_sem *vt_sem_create(void)
 {
    vt_sem *s = (vt_sem*)malloc(sizeof(vt_sem));
@@ -80,6 +102,7 @@ vt_sem *vt_sem_create(void)
 void vt_sem_destroy(vt_sem *s) { if (s) { sem_destroy(&s->s); free(s); } }
 void vt_sem_post(vt_sem *s) { sem_post(&s->s); }
 void vt_sem_wait(vt_sem *s) { while (sem_wait(&s->s) != 0) ; }
+#endif
 
 static void *vt_trampoline(void *p) { (void)p; vt_fn(vt_arg); return NULL; }
 
