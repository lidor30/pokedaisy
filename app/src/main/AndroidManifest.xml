<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Only requested/used when the user picks a custom game-saves folder in
         Settings > Folders > Change folder (see SettingsActivity). Save files are
         opened by raw path from native code, which scoped storage otherwise
         blocks outside this app's own sandbox. Sideloaded app, not distributed
         via Play, so the "All files access" review restriction doesn't apply. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 8-10's counterpart of MANAGE_EXTERNAL_STORAGE (which only exists from 11):
         the linked ROMs / saves folders are opened by raw path (StorageAccess). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Outbound HTTPS, and co-op's own traffic (see below): library cover art (Settings > Cover Art) from SteamGridDB's
         API with a user-supplied key (Prefs.steamGridDbApiKey / SteamGridDbClient) and
         RetroAchievements' box art; the update check against this app's GitHub releases
         (AppUpdater: api.github.com + GitHub's download host); RetroAchievements itself
         once the player signs in (achievements/RetroAchievements.kt); a BEST EFFORT match the player
         chose to SHARE (BestEffortShare: one Firestore write, the fields it showed). ASK FOR SUPPORT and
         the footer links only open a browser. Co-op (below) is the only other use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SecondScreenHolder: the game's task back in front (and the buttons with it) after an AYANEO screen is held. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- TOUCH CONTROLS > VIBRATION's MEDIUM and STRONG: a press's buzz, stronger than the phone's own tick. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Co-op: QUIC to the paired partner, the co-op relay, and mDNS on the local network, and the BY IP hello (a small exchange with the device at the address the player typed), only while CO-OP is in use. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- In-app update: hands a downloaded release APK to Android's installer (AppUpdateFlow). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets AppUpdateFlow find Android's installer (package visibility, 11+) and open
         the update APK with it directly, not through an "Open with" prompt. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".PokeDaisyApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.PokeDaisy">

        <!-- Crash reports are opt-in (CrashReports.kt): nothing is collected or sent
             until the player turns them on in Settings or says yes to the one-time ask. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:theme="@style/Theme.PokeDaisy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.gba" />
                <!-- Game Boy / Color, with TelemetrySampler.GAME_BOY_SUPPORT. -->
                <data android:mimeType="*/*" android:pathPattern=".*\\.gb" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.gbc" />
                <!-- Nintendo DS, with TelemetrySampler.NDS_SUPPORT. -->
                <data android:mimeType="*/*" android:pathPattern=".*\\.nds" />
                <!-- A ROM hack's BPS patch: PATCH A ROM (RomPatchFlow). -->
                <data android:mimeType="*/*" android:pathPattern=".*\\.bps" />
            </intent-filter>
        </activity>

        <!-- For frontends (Cocoon, iiSU, ES-DE, ...): started explicitly with the
             ROM as the intent's data or a "rom"/"ROM" path extra, it opens the
             game directly (see LaunchActivity). No intent filter on purpose -
             explicit launches don't need one, and a VIEW filter would put a
             second PokeDaisy in every "Open with" list next to the library's.
             Its own empty affinity keeps it out of the library's task. -->
        <activity
            android:name=".LaunchActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PokeDaisy.Launch" />

        <!-- An app under the companion (its bars can't be hidden from a Presentation), and AYANEO's bottom screen: an app opened there, so its launcher's panel steps aside for the companion. -->
        <activity
            android:name=".SecondScreenHolder"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PokeDaisy" />

        <!-- Co-op invite links (pokedaisy://coop/<ticket>): parsed, handed to Settings' pairing; reads nothing else (see CoopLinkActivity). -->
        <activity
            android:name=".CoopLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.PokeDaisy.Launch">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pokedaisy" android:host="coop" />
            </intent-filter>
        </activity>

        <!-- Serves a downloaded update APK (cache/updates/) to the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PokeDaisy" />

        <!-- PC BOXES: a game's save read and edited from the library, with the game closed. -->
        <activity
            android:name=".SaveEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.PokeDaisy" />

        <!-- LINK PLAY: two to four GBA games on one link cable (a game's library menu). configChanges keeps the games
             running through a rotation or a controller connecting, as PokeDaisyActivity's. -->
        <activity
            android:name=".LinkActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.PokeDaisy" />

        <!-- No screenOrientation: PokeDaisyActivity locks landscape itself with a second
             screen and follows the device's rotation without one (a phone upright puts the
             companion under the game, PortraitPanel). configChanges keeps the game running
             through a rotation and through a controller connecting ("keyboard": many
             8BitDo / GameSir modes register as one, which restarted the activity). -->
        <activity
            android:name=".PokeDaisyActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask"
            android:parentActivityName=".LibraryActivity"
            android:theme="@style/Theme.PokeDaisy" />
    </application>
</manifest>
