+    bool SkipDrawNext = false;
+    bool SkippingFrame = false;
+    // PokeDaisy (pk_nds_wide.cpp): called as line 192 starts, before VBlank's IRQ and DMAs - the game's VBlank handler
+    // then sets the next frame's registers, palettes and sprites - so the host reads what this frame was drawn with.
+    void (*VisibleEndHook)(GPU& gpu, void* user) = nullptr;
+    void* VisibleEndHookUser = nullptr;
